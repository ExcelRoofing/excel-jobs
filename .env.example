# Copy to .env and fill in before go-live. The app runs without this file.

# Required before real customer data. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL of this app, no trailing slash. Used in customer links and alerts.
APP_URL=http://localhost:3000

# Where the database, photos, and local filing folders live.
# On a server, point this at a persistent disk, for example /data
DATA_DIR=./data

# Show demo emails and the demo password on the login page.
# Default: on. Set to off before go-live.
DEMO_HINTS=on

# Set to on when the site is served over HTTPS.
COOKIE_SECURE=off

# First boot only, when the database is empty.
# SEED_DEMO=off creates one admin and no sample jobs or demo people.
# Leave it unset (or on) for a local demo.
SEED_DEMO=on
BOOTSTRAP_ADMIN_NAME=Joel Fernandes
BOOTSTRAP_ADMIN_EMAIL=joel@excelroofing.ca
BOOTSTRAP_ADMIN_PASSWORD=use-a-real-password
BOOTSTRAP_ADMIN_LOCALE=en

# Phone alerts (Web Push). If empty, the server creates data/vapid.json on first boot.
# Generate a stable pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@excelroofing.ca

# Google Drive mirror. Leave DRIVE_SYNC=off until the keys exist.
# Each file is copied to:  <root folder> / <job name> / <tag> / <file>
# DRIVE_SYNC=off
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Optional. Default is the server disk (STORAGE=local).
# For Cloudflare R2 or another S3-compatible bucket:
# STORAGE=s3
# S3_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
# S3_BUCKET=excel-jobs
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Public hostname for Caddy (Let's Encrypt). No https:// and no path.
# APP_DOMAIN=jobs.excelroofing.ca
# ACME_EMAIL=info@excelroofing.ca

# Daily backup. The compose backup service reads these.
# Keep this many days on the server and on the off-server copy.
BACKUP_RETENTION_DAYS=30
# Set to 1 in production so the backup container restarts until the copy works.
BACKUP_REQUIRE_OFFSITE=0
# rclone destination. Examples:
#   excelbackup:excel-jobs          (remote defined by the RCLONE_CONFIG_* vars below)
#   drive:ExcelJobsBackups          (remote from deploy/rclone/rclone.conf)
# RCLONE_REMOTE=excelbackup:excel-jobs
# S3-compatible off-server copy (OVH Object Storage, R2, or B2):
# RCLONE_CONFIG_EXCELBACKUP_TYPE=s3
# RCLONE_CONFIG_EXCELBACKUP_PROVIDER=Other
# RCLONE_CONFIG_EXCELBACKUP_ENDPOINT=https://s3.bhs.io.cloud.ovh.net
# RCLONE_CONFIG_EXCELBACKUP_ACCESS_KEY_ID=
# RCLONE_CONFIG_EXCELBACKUP_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_EXCELBACKUP_ACL=private
