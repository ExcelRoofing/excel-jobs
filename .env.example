# Copy to .env and fill in before go-live. The app runs without this file.

# Required before real customer data. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL of this app, no trailing slash. Used in customer links and alerts.
APP_URL=http://localhost:3000

# Where the database, photos, and local filing folders live.
# On a server, point this at a persistent disk, for example /data
DATA_DIR=./data

# Show demo emails and the demo password on the login page.
# Default: on. Set to off before go-live.
DEMO_HINTS=on

# Set to on when the site is served over HTTPS.
COOKIE_SECURE=off

# First boot only, when DEMO_HINTS=off and the database is empty:
# create one admin instead of the demo company.
# SEED_DEMO=off
# BOOTSTRAP_ADMIN_NAME=Joel Fernandes
# BOOTSTRAP_ADMIN_EMAIL=joel@excelroofing.ca
# BOOTSTRAP_ADMIN_PASSWORD=use-a-real-password
# BOOTSTRAP_ADMIN_LOCALE=en

# Phone alerts (Web Push). If empty, the server creates data/vapid.json on first boot.
# Generate a stable pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@excelroofing.ca

# Google Drive mirror. Leave DRIVE_SYNC=off until the keys exist.
# Each file is copied to:  <root folder> / <job name> / <tag> / <file>
# DRIVE_SYNC=off
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Optional. Default is the server disk (STORAGE=local).
# For Cloudflare R2 or another S3-compatible bucket:
# STORAGE=s3
# S3_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
# S3_BUCKET=excel-jobs
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
