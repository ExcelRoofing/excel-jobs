# Copy to whatsapp-backup/.env and fill in. The process reads this file on startup.

# Where session, queue, and files waiting to upload are stored.
# In Docker this is /data (a disk that survives restarts).
DATA_DIR=./data

# Admin page. On the server, listen on all interfaces inside Docker
# and publish only 127.0.0.1 on the host. A public address requires ADMIN_TOKEN.
HOST=127.0.0.1
PORT=8787
# Long random password for the status page. Use hex so it is safe in an address bar:
# openssl rand -hex 24
ADMIN_TOKEN=

# Filing clock. Excel Roofing works in Pacific time.
TIME_ZONE=America/Vancouver

# The Drive folder that will hold the backups. Create a folder named
# "WhatsApp Backup" and paste the id from the address bar (after /folders/).
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Label shown on the admin page. The id above should be that folder.
DRIVE_ROOT_NAME=WhatsApp Backup

# --- Google login. Fill ONE of the two blocks. See README. ---

# Block A. Service account. Use this only if the folder is in a Shared Drive.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=backup@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Block B. OAuth refresh token. Use this for a normal company Gmail.
# Create it with: npm run auth
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# How much old chat to ask for on the first run.
# recent = whatever WhatsApp sends a new linked device, plus one small extra pull
# full   = ask for a deep history (uses more memory; still capped by BACKFILL_LIMIT)
# off    = only messages that arrive after login
BACKFILL=recent
BACKFILL_LIMIT=400

# Give up on a file after this many Drive or network failures. It stays on disk
# and on the admin page until someone presses Retry.
MAX_ATTEMPTS=12

# Skip a single file bigger than this (bytes). Default 80 MB.
MAX_MEDIA_BYTES=83886080

# Optional copy into Excel Jobs. Off until the mapping file and login exist.
EXCEL_JOBS_PUSH=off
EXCEL_JOBS_URL=http://127.0.0.1:3000
EXCEL_JOBS_EMAIL=
EXCEL_JOBS_PASSWORD=
EXCEL_JOBS_GROUP_MAP=./group-map.json

# Set to on to run the admin page without connecting to WhatsApp.
WA_DISABLED=off

LOG_LEVEL=info
# Baileys is noisy. Leave this silent unless you are debugging login.
WA_LOG_LEVEL=silent
